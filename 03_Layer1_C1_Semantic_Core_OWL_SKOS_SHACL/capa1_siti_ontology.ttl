ht-of-Way (ROW) Cadastral Parcel and Easement Area\"}, {\"canonical_label_index\": false, \"concept_code\": \"A10_025_065_015\", \"kind\": \"translation\", \"languages\": [\"en\"], \"locators\": [{\"locator\": \"Documentos concesion/Ferreo - Apendice tecnico 7.md :: Sección 2.2 - Elaboración de fichas prediales, estudio de títulos y avalúos\", \"source_id\": \"PUERTA1_RONDA3_CONSOLIDACION_20261024\"}], \"normalized_term\": \"land parcel and real estate unit affected by right-of-way acquisition (a10_025_065_015)\", \"review_basis\": \"Tribunal Adversarial Puerta 1 Ronda 3 Consolidación Pre-Puerta 2\", \"review_status\": \"reviewed\", \"reviewer\": \"Tribunal Adversarial Puerta 1\", \"source_ids\": [\"PUERTA1_RONDA3_CONSOLIDACION_20261024\"], \"term\": \"Land parcel and real estate unit affected by right-of-way acquisition (A10_025_065_015)\"}, {\"canonical_label_index\": false, \"concept_code\": \"A10_025_065_015\", \"kind\": \"translation\", \"languages\": [\"fr\"], \"locators\": [{\"locator\": \"Documentos concesion/Ferreo - Apendice tecnico 7.md :: Sección 2.2 - Elaboración de fichas prediales, estudio de títulos y avalúos\", \"source_id\": \"PUERTA1_RONDA3_CONSOLIDACION_20261024\"}], \"normalized_term\": \"parcelle foncière et bien immobilier affectés par l'acquisition d'emprise (a10_025_065_015)\", \"review_basis\": \"Tribunal Adversarial Puerta 1 Ronda 3 Consolidación Pre-Puerta 2\", \"review_status\": \"reviewed\", \"reviewer\": \"Tribunal Adversarial Puerta 1\", \"source_ids\": [\"PUERTA1_RONDA3_CONSOLIDACION_20261024\"], \"term\": \"Parcelle foncière et bien immobilier affectés par l'acquisition d'emprise (A10_025_065_015)\"}]" ;
    siti:lifecycleStatus "active" ;
