 \\\"2021-08-04\\\"^^xsd:date ;\\n                      rdfs:comment \\\"System that is used to transmit electrical energy to road or rail vehicles.\\\"@en ;\\n                      rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                      rdfs:label \\\"Contact Line System\\\"@en ;\\n                      vs:term_status \\\"stable\\\" .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-10\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/LevelCrossing; línea 17517\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/LevelCrossing\\nera:LevelCrossing rdf:type owl:Class ;\\n                  rdfs:subClassOf era:InfrastructureElement ;\\n                  owl:disjointWith era:OperationalPoint ,\\n                                   era:PlatformEdge ,\\n                                   era:PrimaryLocation ,\\n                                   era:RadioBlockCenter ,\\n                                   era:RunningTrack ,\\n                                   era:SectionOfLine ,\\n                                   era:Siding ,\\n                                   era:Signal ,\\n                                   era:SpecialArea ,\\n                                   era:Switch ,\\n                                   era:Track ,\\n                                   era:Tunnel ;\\n                  era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/LevelCrossingShape> ;\\n                  dcterms:modified \\\"2025-01-30\\\"^^xsd:date ,\\n                                   \\\"2025-03-01\\\"^^xsd:date ;\\n                  rdfs:comment \\\"A level crossing is an intersection where a railway line crosses a road or a path at the same level. It can be used for the implementation of the ETCS trackside or to identify potential collision scenarios\\\"@en ;\\n                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                  rdfs:label \\\"Level crossing\\\"@en .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-12\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/wheelSetGauge; línea 7985\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/wheelSetGauge\\nera:wheelSetGauge rdf:type owl:ObjectProperty ;\\n                  rdfs:subPropertyOf era:trackObjParameter ,\\n                                     era:vehicleTypeTechnicalObjectCharacteristic ;\\n                  rdf:type owl:FunctionalProperty ;\\n                  rdfs:domain [ rdf:type owl:Class ;\\n                                owl:unionOf ( era:CommonCharacteristicsSubset\\n                                              era:Restriction\\n                                              era:RunningTrack\\n                                              era:VehicleRegistrationRestriction\\n                                              era:VehicleType\\n                                              era:VehicleTypeAuthorisationRestriction\\n                                            )\\n                              ] ;\\n                  rdfs:range skos:Concept ;\\n                  era:XMLName \\\"ITP_NomGauge\\\" ;\\n                  era:applicable \\\"Y\\\" ;\\n                  era:eratvIndex \\\"4.1.3\\\" ;\\n                  era:evrIndex \\\"11.9.1\\\" ;\\n                  era:inSkosConceptScheme <http://data.europa.eu/949/concepts/nominal-track-gauges/NominalTrackGauges> ;\\n                  era:legalDeadline \\\"In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest\\\"@en ;\\n                  era:rinfIndex \\\"1.1.1.1.4.1\\\" ,\\n                                \\\"1.2.1.0.4.1\\\" ;\\n                  era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/WheelSetGauge> ,\\n                                               <http://data.europa.eu/949/eratv/shapes/WheelSetGaugeSKOS> ,\\n                                               <http://data.europa.eu/949/shapes/WheelSetGauge> ,\\n                                               <http://data.europa.eu/949/shapes/WheelSetGaugeSKOS> ,\\n                                               <http://data.europa.eu/949/shapes/WheelSetGaugeEVR> ;\\n                  era:usedInRCCCalculations \\\"true\\\"^^xsd:boolean ;\\n                  dcterms:created \\\"2020-07-29\\\"^^xsd:date ;\\n                  dcterms:modified \\\"2024-01-08\\\"^^xsd:date ,\\n                                   \\\"2024-09-19\\\"^^xsd:date ,\\n                                   \\\"2025-02-28\\\"^^xsd:date ,\\n                                   \\\"2025-03-12\\\"^^xsd:date ,\\n                                   \\\"2025-07-15\\\"^^xsd:date ;\\n                  dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;\\n                  rdfs:comment \\\"A single value expressed in millimetres that identifies the track gauge.\\\"@en ;\\n                  rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                  rdfs:label \\\"Nominal track gauge\\\"@en ;\\n                  rdfs:seeAlso \\\"https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf\\\"^^xsd:anyURI ,\\n                               \\\"INF TSI: 4.2.4.1\\\" ;\\n                  vs:term_status \\\"stable\\\" ;\\n                  skos:editorialNote \\\"Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>\\\"@en ;\\n                  skos:note \\\"Harmonised restriction code 2.2.X, with X depending on the selected track gauge.\\\"@en ;\\n                  skos:scopeNote \\\"In case of multi-rail track, a set of data is to be published separately to each pair of rails to be operated as separate track (the whole set of parameters for the separate track has to be delivered be careful then with the track identification). Nominal track gauges provided by the INF TSI are only 1435, 1520, 1524, 1600 and 1668.\\\"@en .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-13\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/cantDeficiency; línea 8562\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/cantDeficiency\\nera:cantDeficiency rdf:type owl:DatatypeProperty ;\\n                   rdfs:subPropertyOf era:trackDataParameter ;\\n                   rdf:type owl:FunctionalProperty ;\\n                   rdfs:domain [ rdf:type owl:Class ;\\n                                 owl:unionOf ( era:CommonCharacteristicsSubset\\n                                               era:RunningTrack\\n                                             )\\n                               ] ;\\n                   rdfs:range xsd:integer ;\\n                   era:XMLName \\\"ITP_CantDeficiency\\\" ;\\n                   era:applicable \\\"Y\\\" ;\\n                   era:formatNote \\\"+/-NNN\\\" ;\\n                   era:legalDeadline \\\"In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest\\\"@en ;\\n                   era:rinfIndex \\\"1.1.1.1.4.2\\\" ;\\n                   era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CantDeficiency> ;\\n                   era:unitOfMeasure unit:MilliM ;\\n                   era:usedInRCCCalculations \\\"true\\\"^^xsd:boolean ;\\n                   dcterms:created \\\"2020-08-24\\\"^^xsd:date ;\\n                   dcterms:modified \\\"2021-09-10\\\"^^xsd:date ,\\n                                    \\\"2024-09-19\\\"^^xsd:date ,\\n                                    \\\"2025-02-28\\\"^^xsd:date ;\\n                   dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;\\n                   rdfs:comment \\\"Maximum cant deficiency expressed in millimetres defined as difference between the applied cant and a higher equilibrium cant the line has been designed for.\\\"@en ;\\n                   rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                   rdfs:label \\\"Cant deficiency\\\"@en ;\\n                   rdfs:seeAlso \\\"INF TSI: 4.2.4.3\\\" ;\\n                   vs:term_status \\\"stable\\\" ;\\n                   skos:scopeNote \\\"In case of positive value of cant deficiency or zero symbol  '+' shall be applied. In case of negative cant deficiency symbol '-' has to be selected. Value of the cant deficiency shall be given in millimetres. In case of lateral uncompensated acceleration on a 1435 mm track gauge of 1.0 m/s2 the value of 153 mm may be published.\\\"@en .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-14\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/maxAxleLoadOfSoL; línea 12202\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/maxAxleLoadOfSoL\\nera:maxAxleLoadOfSoL rdf:type owl:DatatypeProperty ;\\n                     rdfs:subPropertyOf era:networkStatementsDataCharacteristic ;\\n                     rdf:type owl:FunctionalProperty ;\\n                     rdfs:domain era:SectionOfLine ;\\n                     rdfs:range xsd:double ;\\n                     era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/MaxAxleLoadOfSoL> ;\\n                     era:unitOfMeasure unit:TONNE ;\\n                     dcterms:created \\\"2025-09-29\\\"^^xsd:date ;\\n                     rdfs:comment \\\"Maximum permitted axle load, given in tons.\\\"@en ;\\n                     rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                     rdfs:label \\\"Maximum Axle load\\\"@en ;\\n                     rdfs:seeAlso \\\"UIC leaflet 700-0\\\"@en ;\\n                     vs:term_status \\\"unstable\\\" .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-15\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/gradientProfile; línea 9998\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/gradientProfile\\nera:gradientProfile rdf:type owl:DatatypeProperty ;\\n                    rdfs:subPropertyOf era:lineLayoutDataParameter ;\\n                    rdfs:domain [ rdf:type owl:Class ;\\n                                  owl:unionOf ( era:CommonCharacteristicsSubset\\n                                                era:RunningTrack\\n                                              )\\n                                ] ;\\n                    rdfs:range xsd:string ;\\n                    era:XMLName \\\"ILL_GradProfile\\\" ;\\n                    era:applicable \\\"Y\\\" ;\\n                    era:formatNote \\\"in XML:  +/-NN.N (+/-NNNN.NNN)\\\" ;\\n                    era:legalDeadline \\\"In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest\\\"@en ;\\n                    era:rinfIndex \\\"1.1.1.1.3.6\\\" ;\\n                    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/GradientProfile> ;\\n                    era:tsiOPEAppendixD2Index \\\"3.2.1\\\" ,\\n                                              \\\"3.2.2\\\" ;\\n                    era:usedInRCCCalculations \\\"true\\\"^^xsd:boolean ;\\n                    dcterms:created \\\"2020-08-24\\\"^^xsd:date ;\\n                    dcterms:modified \\\"2021-09-10\\\"^^xsd:date ,\\n                                     \\\"2024-09-19\\\"^^xsd:date ,\\n                                     \\\"2025-02-28\\\"^^xsd:date ;\\n                    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;\\n                    rdfs:comment \\\"Sequence of gradient values and locations of change in gradient\\\"@en ;\\n                    rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                    rdfs:label \\\"Gradient profile\\\"@en ;\\n                    rdfs:seeAlso \\\"INF TSI: 4.2.3.3\\\" ;\\n                    vs:term_status \\\"stable\\\" ;\\n                    skos:scopeNote \\\"\\\"\\\"Data on the values of gradient along a SoL is given as a chain of information:\\n\\nGradient (location) The first location corresponding to the start of the first value of the gradient is the centre point of start OP. If there are different values of the gradient, the parameter will be repeated. The last location will correspond to the point where the last value of the gradient starts. This value will be available until the centre point of the end OP. \\n\\nIf there is only one value for the gradient along the track, then the location is not required, only the +/-NN.N value is expected.\\n\\nGradient is expressed in mm/m; location is expressed in km of the line.\\n\\nPositive gradient (uphill) is marked with \\\\\\\"+\\\\\\\" and negative gradient (downhill) is marked by \\\\\\\"-\\\\\\\".\\n\\nThe sequence shall follow the increasing kilometres of the line, and this does not take into consideration the running direction of the specific track. This will make the profile easier to read.\\n\\nChanges in gradient shall be registered only as far as necessary for train running calculations (minimum length of constant gradient shall be 500 m, the minimum change of gradient value shall be 0,5 mm/m).\\n\\nThe required precision for gradient value is 0,5 mm/m, the required precision of location of the points of change of gradient is 10 m. The points of change of gradient are the points of vertical intersection of each vertical curve.\\\"\\\"\\\"@en .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-16\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/minimumHorizontalRadius; línea 13302\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/minimumHorizontalRadius\\nera:minimumHorizontalRadius rdf:type owl:DatatypeProperty ;\\n                            rdfs:subPropertyOf era:lineLayoutDataParameter ,\\n                                               era:sidingDataParameter ,\\n                                               era:vehicleTypeTechnicalDataCharacteristic ;\\n                            rdf:type owl:FunctionalProperty ;\\n                            rdfs:domain [ rdf:type owl:Class ;\\n                                          owl:unionOf ( era:CommonCharacteristicsSubset\\n                                                        era:RunningTrack\\n                                                        era:Siding\\n                                                        era:VehicleType\\n                                                        era:Restriction\\n                                                      )\\n                                        ] ;\\n                            rdfs:range [ rdf:type rdfs:Datatype ;\\n                                         owl:unionOf ( xsd:decimal\\n                                                       xsd:integer\\n                                                     )\\n                                       ] ;\\n                            era:XMLName \\\"ILL_MinRadHorzCurve\\\" ;\\n                            era:applicable \\\"Y/N\\\" ;\\n                            era:eratvIndex \\\"4.8.4\\\" ;\\n                            era:evrIndex \\\"11.9.1\\\" ;\\n                            era:formatNote \\\"NNNNN\\\" ;\\n                            era:legalDeadline \\\"In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest\\\"@en ;\\n                            era:rinfIndex \\\"1.1.1.1.3.7\\\" ,\\n                                          \\\"1.2.2.0.3.2\\\" ;\\n                            era:shaclShapeValidationRule <http://data.europa.eu/949/eratv/shapes/MinimumHorizontalRadius> ,\\n                                                         <http://data.europa.eu/949/shapes/MinimumHorizontalRadius> ,\\n                                                         <http://data.europa.eu/949/shapes/MinimumHorizontalRadiusEVR> ;\\n                            era:unitOfMeasure unit:M ;\\n                            era:usedInRCCCalculations \\\"true\\\"^^xsd:boolean ;\\n                            dcterms:created \\\"2020-08-24\\\"^^xsd:date ;\\n                            dcterms:modified \\\"2021-09-10\\\"^^xsd:date ,\\n                                             \\\"2024-09-19\\\"^^xsd:date ,\\n                                             \\\"2025-02-26\\\"^^xsd:date ,\\n                                             \\\"2025-03-13\\\"^^xsd:date ,\\n                                             \\\"2025-06-24\\\"^^xsd:date ;\\n                            dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28> ;\\n                            rdfs:comment \\\"Radius of the smallest horizontal curve of the track in metres.\\\"@en ;\\n                            rdfs:isDefinedBy <http://data.europa.eu/949/> ;\\n                            rdfs:label \\\"Minimum radius of horizontal curve\\\"@en ;\\n                            rdfs:seeAlso \\\"https://www.era.europa.eu/system/files/2022-11/list_harmonised_national_restriction_codes_en.pdf\\\"^^xsd:anyURI ,\\n                                         \\\"\\\"\\\"INF TSI: 4.2.3.4\\nEN 13803:2017, Tables N.A and N.2\\\"\\\"\\\" ;\\n                            vs:term_status \\\"stable\\\" ;\\n                            skos:altLabel \\\"ERATV: Radius of the smallest horizontal curve capability of the vehicle, expressed in metres.\\\"@en ;\\n                            skos:editorialNote \\\"Present and unchanged since <http://data.europa.eu/eli/dec_impl/2011/665>\\\"@en ;\\n                            skos:note \\\"Harmonised restriction code 1.1.X, with X the value in meters of this property.\\\"@en ;\\n                            skos:scopeNote \\\"To describe a straight section of line value \\\\\\\" 99999\\\\\\\" shall be used.\\\"@en .\\n\\n\", \"source_date_note\": \"La cabecera declara issued 2024-04-18; la versión y fecha de cada término se conservan en el bloque\", \"version\": \"v3.3.4\", \"year\": null}, \"EI_EI-17\": {\"author\": \"Ghislain Atemezing; Maarten Duhoux; Dragos Patru\", \"kind\": \"Ontología externa; fuente semántica, sin adopción normativa colombiana\", \"locator\": \"http://data.europa.eu/949/energySupplySystem; línea 2583\", \"path\": \"Biblioteca_ontologias_transporte/20260908/originales/ERA/ontology.ttl\", \"publisher\": \"European Union Agency for Railways\", \"sha256\": \"9081264e5059029ec91cc5fab7f310cc4d764788f9d37f330504e4955e6de289\", \"source_block\": \"###  http://data.europa.eu/949/energySupplySystem\\nera:energySupplySystem rdf:type owl:ObjectProperty ;\\n                       rdfs:subPropertyOf era:contactLineSystemObjParameter ,\\n                                          era:vehicleTypeTechnicalObjectCharacteristic ;\\n                       rdf:type owl:FunctionalProperty ;\\n                       rdfs:domain [ rdf:type owl:Class ;\\n                                     owl:unionOf ( era:ContactLineSystem\\n                                                   era:VehicleType\\n                                                 )\\n                                   ] ;\\n                       rdfs:range skos:Concept ;\\n                       era:XMLName \\\"ECS_VoltFreq\\\" ;\\n                       era:applicable \\\"Y/N\\\" ;\\n                       era:dependencyNote \\\"When `not electrified` is chosen in parameter 1.1.1.2.2.1.1, then this parameter is not applicable.\\\"@en ;\\n                       