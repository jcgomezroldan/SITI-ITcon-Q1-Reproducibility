    siti:recetaEnsamblajeIntertabular "{\"a10_code\": \"A10_005_005\", \"a10_label\": \"Municipio portuario / nodo logístico con condición PDET/ZOMAC/Frontera\", \"a20_code\": \"A20_020_005\", \"a20_label\": \"Complejo portuario marítimo o fluvial conectado con patio férreo A20_040_070_010\", \"a30_code\": \"A30_015_075\", \"a30_label\": \"Zona de espuela férrea portuaria y patio de transferencia intermodal\", \"a40_code\": \"A40_140_010\", \"a40_label\": \"Sistema de vía en placa de concreto en muelle y patio de contenedores\", \"a50_code\": \"A50_050_060_010\", \"a50_label\": \"Aparato de desvío férreo y tope de final de vía en patio portuario\", \"b30_codes\": [\"B30_015_020_035\", \"B30_015_020_040\", \"B30_010_040_175\"], \"b40_codes\": [\"B40_025_005_015\", \"B40_025_015_005\"], \"b50_codes\": [\"B50_010_015_015_045\", \"B50_010_015_015_050\", \"B50_040_010_005\"], \"chain_pattern\": \"A10 -> A20 -> A30 -> A40 -> A50 (+ B30 / B40 / B50)\", \"cypher_path\": \"(a10:ClaseC1 {codigo:'A10_005_005'})-[:CONTIENE_SISTEMA]->(a20:ClaseC1 {codigo:'A20_020_005'})-[:INTEGRA_ZONA_ESPACIAL]->(a30:ClaseC1 {codigo:'A30_015_075'})-[:INTEGRA_ELEMENTO_CONSTRUCTIVO]->(a40:ClaseC1 {codigo:'A40_140_010'})-[:SOPORTA_COMPONENTE]->(a50:ClaseC1 {codigo:'A50_050_060_010'})\", \"meronymy_proof\": \"Articula dos complejos modales (A20 puerto y A20 patio férreo) mediante relación intermodal explícita en C2.\", \"normative_authority\": \"Plan Maestro de Transporte Intermodal (PMTI) y Apéndice Técnico 1 ANI\", \"recipe_category\": \"ENSAMBLAJE_ACTIVO_FISico_A10_A50\", \"recipe_id\": \"REC-A-07\", \"recipe_name\": \"Nodo intermodal puerto-ferrocarril-carretera y transferencia de carga\"}",
        "{\"a10_code\": \"A10_005_005\", \"a10_label\": \"Municipio y microcuenca aferente al corredor vial\", \"a20_code\": \"A20_035_005_020\", \"a20_label\": \"Complejo de carreteras y autopistas\", \"a30_code\": \"A30_035_005_040\", \"a30_label\": \"Calzada / carril y margen hidráulica del derecho de vía\", \"a40_code\": \"A40_055_005\", \"a40_label\": \"Sistema de drenaje de aguas lluvias y subdrenaje (junto con disipación A40_095_005_010)\", \"a50_code\": \"A50_045_005_035_005\", \"a50_label\": \"Cuneta revestida, alcantarilla y disipador de energía hidráulica\", \"b30_codes\": [\"B30_010_020_180\", \"B30_010_025_150\", \"B30_010_025_155\"], \"b40_codes\": [\"B40_020_035_935\", \"B40_020_035_945\", \"B40_025_005_020\"], \"b50_codes\": [\"B50_010_035_010_030\", \"B50_005_035_050\"], \"chain_pattern\": \"A10 -> A20 -> A30 -> A40 -> A50 (+ B30 / B40 / B50)\", \"cypher_path\": \"(a10:ClaseC1 {codigo:'A10_005_005'})-[:CONTIENE_SISTEMA]->(a20:ClaseC1 {codigo:'A20_035_005_020'})-[:INTEGRA_ZONA_ESPACIAL]->(a30:ClaseC1 {codigo:'A30_035_005_040'})-[:INTEGRA_ELEMENTO_CONSTRUCTIVO]->(a40:ClaseC1 {codigo:'A40_055_005'})-[:SOPORTA_COMPONENTE]->(a50:ClaseC1 {codigo:'A50_045_005_035_005'})\", \"meronymy_proof\": \"Desacopla la obra de drenaje (A40/A50) del concreto y geodrenes (B30) y del ítem APU de excavación/instalación (B40_020_035_935).\", \"normative_authority\": \"Manual de Drenaje para Carreteras INVIAS, Reglas R09–R11 y Capítulo 600 INVIAS\", \"recipe_category\": \"ENSAMBLAJE_ACTIVO_FISico_A10_A50\", \"recipe_id\": \"REC-A-05\", \"recipe_name\": \"Sistema de drenaje longitudinal, transversal y geotecnia vial\"}",
        "{\"a10_code\": \"A10_005_005\", \"a10_label\": \"Municipios beneficiados (con banderas B50_025_005 PDET / B50_025_010 ZOMAC)\", \"a20_code\": \"A20_035_005_020\", \"a20_label\": \"Proyecto de concesión vial o férrea (A20_040_005_005)\", \"a30_code\": \"A30_035_010_015\", \"a30_label\": \"Estaciones de peaje que alimentan la subcuenta de recaudo\", \"a40_code\": \"A40_045_005_030\", \"a40_label\": \"Unidades Funcionales (UF) objeto de inversión CAPEX\", \"a50_code\": \"A50_035_035_010\", \"a50_label\": \"Puntos de aforo y recaudo auditados por OETR\", \"b30_codes\": [\"B30_015_015_040\"], \"b40_codes\": [\"B40_025_005_025\", \"B40_025_015_010\"], \"b50_codes\": [\"B50_040_010_005\", \"B50_035_055\", \"B50_035_060\", \"B50_035_035\"], \"chain_pattern\": \"B20 -> B10 -> B50 -> A20\", \"cypher_path\": \"(b20e:ClaseC1 {codigo:'B20_030_005_020'})-[:EMITE_DOCUMENTO]->(b10s:ClaseC1 {codigo:'B10_010_005_065'})-[:DEFINE_INDICADOR]->(b50r:ClaseC1 {codigo:'B50_040_010_005'}), (b20f:ClaseC1 {codigo:'B20_030_005_025'})-[:AUDITA_CUMPLIMIENTO]->(b10f:ClaseC1 {codigo:'B10_010_010_260'})-[:DEFINE_INDICADOR]->(b50v:ClaseC1 {codigo:'B50_035_055'})\", \"meronymy_proof\": \"Conecta actores (B20), estudios/apéndices financieros (B10) y métricas económicas (B50) mediante relaciones intertabulares.\", \"normative_authority\": \"Ley 1508 de 2012, Apéndice Financiero 1.1 ANI y Guía AASHTO TAM (2022)\", \"recipe_category\": \"CIRCUITO_GOBERNANZA_SECTORIAL_B10_B50\", \"recipe_id\": \"REC-B-01\", \"recipe_name\": \"Estructuración APP, registro BPIN/CONPES, cierre financiero y fiducia\"}",
        "{\"a10_code\": \"A10_005_005\", \"a10_label\": \"Zona geográfica / Región INVIAS del proyecto\", \"a20_code\": \"A20_035_005_020\", \"a20_label\": \"Corredor vial intervenido\", \"a30_code\": \"A30_035_005_040\", \"a30_label\": \"Calzada, puente (A30_035_005_070) o túnel (A30_035_005_075)\", \"a40_code\": \"A40_045_005_030\", \"a40_label\": \"Elemento constructivo ejecutado (pavimento, estructura, drenaje)\", \"a50_code\": \"A50_015_005_025\", \"a50_label\": \"Componente funcional instalado\", \"b30_codes\": [\"B30_010_005_175\", \"B30_010_020_180\", \"B30_010_020_185\", \"B30_010_030_170\", \"B30_010_040_180\", \"B30_015_015_045\"], \"b40_codes\": [\"B40_020_035_905\", \"B40_020_035_910\", \"B40_020_035_915\", \"B40_020_035_920\", \"B40_020_035_925\", \"B40_020_035_930\", \"B40_020_035_935\", \"B40_020_035_940\", \"B40_020_035_945\"], \"b50_codes\": [\"B50_035_060\", \"B50_005_035_020\", \"B50_005_035_030\", \"B50_005_035_040\"], \"chain_pattern\": \"B20 -> B10 -> B40 -> B30 -> B50 -> A40/A50\", \"cypher_path\": \"(b20:ClaseC1 {codigo:'B20_025_005_00010'})-[:EMITE_DOCUMENTO]->(b10:ClaseC1 {codigo:'B10_010_030_015'})<-[:REGIDO_POR_NORMA]-(b40:ClaseC1 {codigo:'B40_020_035_920'})-[:CONSUME_RECURSO_B30]->(b30:ClaseC1 {codigo:'B30_010_030_170'}), (b40)-[:INTERVIENE_ACTIVO]->(a40:ClaseC1 {codigo:'A40_045_005_030'})\", \"meronymy_proof\": \"Demuestra cómo cualquier ítem APU compuesto se desacopla en Actividad (B40) + Insumo/Equipo (B30) + Especificación/Precio (B50) + Activo (A40/A50).\", \"normative_authority\": \"Especificaciones Generales de Construcción de Carreteras INVIAS y Catálogo Oficial APU (73.640 registros regionales)\", \"recipe_category\": \"CIRCUITO_GOBERNANZA_SECTORIAL_B10_B50\", \"recipe_id\": \"REC-B-02\", \"recipe_name\": \"Presupuestación por Análisis de Precios Unitarios (APU INVIAS Capítulos 200 a 900) y ejecución de obra\"}" ;
