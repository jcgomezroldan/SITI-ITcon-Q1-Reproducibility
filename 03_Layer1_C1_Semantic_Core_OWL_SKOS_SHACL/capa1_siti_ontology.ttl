    siti:dataContract "{\"category\": \"PDET\", \"creates_assets\": false, \"determines_benefits\": false, \"domain_table\": \"A10\", \"mutually_exclusive\": false, \"negative_requirement\": \"complete_legal_list_and_reviewed_identity;FRONTERA_negative_forbidden\", \"referent_kind\": \"classification_concept\", \"scope_required\": true, \"time_interval\": \"[valid_from,valid_to);[recorded_from,recorded_to)\", \"unit\": null, \"valid_time_basis\": \"Normative start only where verified; confirmed_cut_only is a supported interval starting at the cut, not a new legal declaration.\", \"values\": [\"si\", \"no\", \"desconocido\"], \"verified_through\": \"Inclusive evidence cut, never legal expiry; later effective dates return unknown.\"}" ;
