    siti:dataContract "{\"allowed_units\": [\"t\"], \"allowed_value_roles\": [\"permitted\"], \"context_types\": {\"applicability\": \"string_or_object\", \"authority\": \"string\", \"referent_id\": \"string\", \"source_version\": \"string\", \"valid_time\": \"object\", \"value_role\": \"string\", \"vehicle_category\": \"string\"}, \"definition_source_ids\": [\"EI_EI-14\"], \"exclusive_minimum\": 0, \"integer\": false, \"missing_value\": null, \"normative_limits_imported\": false, \"notes\": \"Fuente externa unstable; la unidad es masa. No equivale a fuerza, capacidad estructural, masa medida o ESAL. Límite de masa aplicable positivo; un cero recibido se conserva como fuente y requiere revisión, no se convierte en cierre.\", \"required_context\": [\"source_id\", \"source_version\", \"referent_id\", \"value_role\", \"valid_time\", \"unit\", \"status\", \"authority\", \"applicability\", \"vehicle_category\"], \"value_kind\": \"finite_number\"}" ;
