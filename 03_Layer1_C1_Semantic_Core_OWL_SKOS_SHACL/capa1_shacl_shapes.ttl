        sh:name "Pset_AlignmentHorizontal.MinimumHorizontalRadius" ;
        sh:description "Umbral normativo: >= 29.0 [m] (Regla R02 - Radio mínimo según velocidad y peralte máximo (Tabla 3.2 INVIAS))"@es ;
        sh:severity sh:Violation ;
        sh:minInclusive 29.0 ;
    ] .

