    rdfs:label "Nivel de contención certificado de barrera de seguridad vial (MASH TL-3 / EN 1317 N2-H2) (R21)"@es ;
    sh:property [
        sh:path siti:ContainmentLevelMASH ;
        sh:name "Pset_SafetyBarrier.ContainmentLevelMASH" ;
        sh:description "Umbral normativo: IN ('TL-3', 'TL-4', 'N2', 'H1', 'H2', 'H4b') [adimensional] (Regla R21 - Desempeño al impacto de sistemas de contención vehicular)"@es ;
        sh:severity sh:Violation ;
        sh:in ('TL-3' 'TL-4' 'N2' 'H1' 'H2' 'H4b') ;
    ] .

siti:Shape_PAR_B50_0022_CaliforniaBearingRatioCBR a sh:NodeShape ;
    sh:targetClass siti:B30_010_075 , siti:B30_010_005 , siti:A40_045_005_030 ;
    siti:b50Concept siti:B50_005_035_005 ;
    rdfs:label "Relación de soporte de California (CBR) mínima para subrasante y capas granulares (R22)"@es ;
    sh:property [
