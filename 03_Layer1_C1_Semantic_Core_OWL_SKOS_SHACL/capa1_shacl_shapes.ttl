@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix siti: <https://siti.ani.gov.co/ontologia/v1#> .

# ==============================================================================
# SITI — CAPA 1 (C1): FORMAS SHACL DE CLAUSURA DE MUNDO CERRADO (OWA -> CWA)
# Archivo: Fase_activa_nueva/SITI/capa1_ontologia/capa1_shacl_shapes.ttl
# Publicación Semántica Base: 9a3cc6d9a341e551b95fecf286948fb2
# Unificación integral de Plan Maestro Ola 1 (§3.2) y Gran Blueprint Maestro (§2.1.3)
# ==============================================================================

<https://siti.ani.gov.co/ontologia/v1#Capa1ShaclShapesGraph>
    a owl:Ontology ;
    rdfs:label "Contratos Declarativos SHACL de Clausura Epistémica OWA -> CWA de SITI (Fase V-B Ola 1)"@es ;
    siti:activeCasPublication "9a3cc6d9a341e551b95fecf286948fb2"^^xsd:string ;
    siti:versionTag "2026-10-21.fase5-unboxed.ola1.1"^^xsd:string .

# ------------------------------------------------------------------------------
# 1. [B3553] Clausura Epistémica OWA -> CWA para Recepción Contractual en
#    Estación 2 (SITI_ARQUETIPOS / SITI_REGLAS)
# ------------------------------------------------------------------------------
siti:SitiAssetContractualClosureShape
    a sh:NodeShape ;
    rdfs:label "Forma SHACL de clausura contractual para activos físicos A10..A50"@es ;
    sh:targetClass siti:A10_ComplejoInfraestructura ,
                   siti:A20_SistemaFuncional ,
                   siti:A30_ZonaEspacioTransporte ,
                   siti:A40_ElementoConstructivo ,
                   siti:A50_ComponenteTecnico ;
    sh:closed false ;
    sh:property [
        sh:path siti:hasSitiCanonicalCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^(A10|A20|A30|A40|A50)_[0-9]{3}(_[0-9]{3,5})*$" ;
        sh:message "Violación C1 [B3553]: Todo activo radicado debe poseer exactamente un código canónico SITI A10..A50 válido verificado en catalogo_semantico.parquet."@es ;
    ] ;
    sh:property [
        sh:path siti:hasAssetUuidV5 ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ;
        sh:message "Violación C1 [B3161]: El identificador estructural del activo debe ser un UUIDv5 determinista válido (RFC 4122 / RFC 9562)."@es ;
    ] ;
    sh:property [
        sh:path siti:hasCrsEpsgCode ;
        sh:datatype xsd:integer ;
        sh:hasValue 9377 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Violación Geodésica [B3138]: El sistema de referencia oficial obligatorio es MAGNA-SIRGAS Origen Nacional (EPSG:9377)."@es ;
    ] .

# ------------------------------------------------------------------------------
# 2. Regla SHACL de Prohibición de Meronimia Intratabular (Regla always_on
#    siti-invarianza-3-capas.md — DAG LIVRPS A10 -> A20 -> A30 -> A40 -> A50)
# ------------------------------------------------------------------------------
siti:SitiIntertabularCompositionShape
    a sh:NodeShape ;
    rdfs:label "Forma SHACL de invarianza intertabular y bloqueo de meronimia intratabular"@es ;
    sh:targetSubjectsOf siti:esParteDeIntertabular ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Violación Taxonómica: Prohibida la meronimia intratabular (Ax -> Ax) o inversión jerárquica fuera del DAG A10->A20->A30->A40->A50."@es ;
        sh:select """
            PREFIX siti: <https://siti.ani.gov.co/ontologia/v1#>
            SELECT $this ?parent ?codeChild ?codeParent
            WHERE {
                $this siti:esParteDeIntertabular ?parent .
                $this siti:hasSitiCanonicalCode ?codeChild .
                ?parent siti:hasSitiCanonicalCode ?codeParent .
                FILTER (
                    SUBSTR(?codeChild, 1, 3) = SUBSTR(?codeParent, 1, 3) ||
                    SUBSTR(?codeChild, 1, 3) < SUBSTR(?codeParent, 1, 3)
                )
            }
        """ ;
    ] .

# ------------------------------------------------------------------------------
# 3. Forma SHACL de Clausura CWA para Actas de Liquidación Fiduciaria
#    Smart Escrow 85/15 (Producto O-2 · Volumen II §2.1.3 Gran Blueprint Maestro)
# ------------------------------------------------------------------------------
siti:SmartEscrow8515MetrologicalShape
    a sh:NodeShape ;
    rdfs:label "Forma SHACL CWA de control metrológico y fiduciario para Acta de pago B10_010_040_0050"@es ;
    sh:targetClass siti:B10_010_040_0050 ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label skos:notation ) ;
    sh:property [
        sh:path siti:metrologicalGrade ;
        sh:datatype xsd:string ;
        sh:hasValue "GRADO_A_RTK" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA Estación 2/4: El giro fiduciario Smart Escrow 85/15 exige grado metrológico GRADO_A_RTK."@es ;
    ] ;
    sh:property [
        sh:path siti:medianReprojectionErrorPx ;
        sh:datatype xsd:double ;
        sh:maxInclusive 1.25 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA Estación 2/4: El error mediano de reproyección fotogramétrica/4DGS debe ser <= 1,25 px."@es ;
    ] ;
    sh:property [
        sh:path siti:scfSignedComplianceValue ;
        sh:datatype xsd:double ;
        sh:maxInclusive 0.0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA [B4088, B4172]: El Campo de Cumplimiento con Signo S(X_t) debe ser exactamente <= 0,0."@es ;
    ] ;
    sh:property [
        sh:path siti:erpWriteBackEmitted ;
        sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA [B4521]: Prohibida la escritura automática en el ERP sin firma humana HITL."@es ;
    ] .

# ------------------------------------------------------------------------------
# 4. Forma SHACL de Clausura CWA de Raíz de Confianza en Hardware TPM 2.0 y
#    Pruebas de Conocimiento Cero ZKP de 64 Bytes (H-18 · Volumen II §2.1.3)
# ------------------------------------------------------------------------------
siti:HardwareTrustTpmZkpShape
    a sh:NodeShape ;
    rdfs:label "Forma SHACL CWA de atestación física TPM 2.0 y ZK-Proof de 64 bytes para sensores críticos A50"@es ;
    sh:targetClass siti:A50_035_025_050 ,
                   siti:A50_035_025_060 ,
                   siti:A50_035_015_035 ,
                   siti:A50_035_015_005 ,
                   siti:A50_035_035_115 ;
    sh:property [
        sh:path siti:isHardwareVerified ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA H-18 [B3690]: La telemetría crítica requiere atestación física TPM 2.0 (is_hardware_verified = true)."@es ;
    ] ;
    sh:property [
        sh:path siti:zkpPedersenSchnorrBytes ;
        sh:datatype xsd:integer ;
        sh:hasValue 64 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Bloqueo CWA H-18 [B3684]: La prueba de conocimiento cero Pedersen/Schnorr debe medir exactamente 64 bytes."@es ;
    ] .

# ==============================================================================
# 5. CATÁLOGO UNIFICADO DE 100 FORMAS SHACL PARAMÉTRICAS B50 (PAR-B50-0001..0100)
#    Integración directa en el grafo canónico capa1_shacl_shapes.ttl (Puerta 2.5)
# ==============================================================================
@prefix siti: <http://www.semanticweb.org/jcgr/SITI/> .

# Formas SHACL de prevalidación normativa (Puerta 1 / Puerta 2 - SITI)

siti:Shape_PAR_B50_0001_DesignSpeed a sh:NodeShape ;
    sh:targetClass siti:A20_035_005_005 , siti:A30_035_005_040 ;
    siti:b50Concept siti:B50_015_015 ;
    rdfs:label "Velocidad de diseño del tramo homogéneo (R01)"@es ;
    sh:property [
        sh:path siti:DesignSpeed ;
        sh:name "Pset_RoadDesignCriteria.DesignSpeed" ;
        sh:description "Umbral normativo: [30.0, 120.0] [km/h] (Regla R01 - Velocidad de diseño Vtr (Manual de Diseño Geométrico INVIAS Tabla 2.1))"@es ;
        sh:severity sh:Violation ;
        sh:minInclusive 30.0 ; sh:maxInclusive 120.0 ;
    ] .

